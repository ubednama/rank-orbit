# ============================================
# Rank Orbit - Global Environment Configuration
# ============================================
# This file consolidates configuration for API Gateway and Crawler Service
# which run from the workspace root.

# -----------------
# Shared Configuration
# -----------------
NODE_ENV=development
LOG_LEVEL=log

# -----------------
# Database & Cache
# -----------------
# Database Configuration (Prisma / PostgreSQL)
# For Render external connection: postgres://user:password@host.render.com/db_name?ssl=true
DATABASE_URL="postgresql://user:password@localhost:5432/rank_orbit?schema=public"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379"

# -----------------
# API Gateway Service
# -----------------
API_GATEWAY_PORT=3333

# Microservices URLs for Gateway to connect to
CRAWLER_SERVICE_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000/api

# CORS Configuration (comma-separated list of allowed origins)
# Add your client URLs here (local and production)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5000

# -----------------
# Crawler Service
# -----------------
CRAWLER_PORT=3001

# Puppeteer Configuration
# Set to 'true' to run headless Chrome (recommended for production)
PUPPETEER_HEADLESS=true

# Optional: Chrome executable path (for custom setups)
# CHROME_EXECUTABLE_PATH=/path/to/chrome

# -----------------
# Auth0 Configuration
# -----------------
# [SHARED] The base URL of your Auth0 tenant (add https://)
AUTH0_ISSUER_BASE_URL='https://YOUR_AUTH0_DOMAIN'

# [BACKEND] The unique identifier you set for your API
AUTH0_AUDIENCE='https://api.rank-orbit.com' 

# [FRONTEND] Client ID from Auth0 Application
AUTH0_CLIENT_ID='YOUR_CLIENT_ID'

# [FRONTEND] Client Secret from Auth0 Application
AUTH0_CLIENT_SECRET='YOUR_CLIENT_SECRET'

# [FRONTEND] A long, random string to encrypt the session cookie
AUTH0_SECRET='long_random_string'

# [FRONTEND] The base URL of your local application
AUTH0_BASE_URL='http://localhost:5000'