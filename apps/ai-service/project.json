{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service/app",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "source venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
        "cwd": "apps/ai-service"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
        "cwd": "apps/ai-service"
      }
    }
  }
}
