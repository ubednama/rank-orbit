# =============================================================================
# ai-service (FastAPI) — required env vars
# =============================================================================

# ---- Server ----
AI_SERVICE_PORT=8000

# ---- AI provider (Gemini via langchain-google-genai) ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash

# =============================================================================
# Deferred — wire up when the corresponding feature lands
# =============================================================================

# Internal-token HMAC verification (only the gateway worker should call us)
# Generate with: openssl rand -hex 32
# INTERNAL_TOKEN_SECRET=
