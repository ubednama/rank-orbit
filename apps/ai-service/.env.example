# =============================================================================
# ai-service (FastAPI) — required env vars
# =============================================================================

# ---- Server ----
# Default 7860 — Hugging Face Spaces convention; matches the production
# Dockerfile so local mirrors deploy.
AI_SERVICE_PORT=7860

# ---- Body size cap ----
# Reject requests whose Content-Length exceeds this many bytes (1 MiB default).
# The audit payload (page_content + lighthouse + metadata) is well under this.
AI_SERVICE_BODY_LIMIT_BYTES=1048576

# ---- AI provider (Gemini via langchain-google-genai) ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash

# =============================================================================
# Deferred — wire up when the corresponding feature lands
# =============================================================================

# Internal-token HMAC verification (only the gateway worker should call us)
# Generate with: openssl rand -hex 32
# INTERNAL_TOKEN_SECRET=
