# Server
API_GATEWAY_PORT=3333
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5000
LOG_LEVEL=info

# Service URLs
CRAWLER_SERVICE_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000/api

# Cache + Queue (Upstash Redis runs both per ADR 003 — BullMQ uses this same URL)
REDIS_URL="rediss://default:password@host:6379"

# Database (Supabase)
# Transaction Pooler (Port 6543) — runtime
DATABASE_URL="postgresql://postgres.user:password@host:6543/postgres"
# Direct Connection (Port 5432) — required for migrations (no pgbouncer flag)
DIRECT_URL="postgresql://postgres.user:password@host:5432/postgres?sslmode=require"

# Phase 2 — DIY JWT (jsonwebtoken). Generate via: openssl rand -hex 32
# JWT_SECRET=
# JWT_ACCESS_TTL=30m
# JWT_REFRESH_TTL=30d

# Phase 1 — internal-token HMAC for gateway → ai-service / crawler-service
# INTERNAL_TOKEN_SECRET=

# Stripe (Phase 4 — paid tier)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
