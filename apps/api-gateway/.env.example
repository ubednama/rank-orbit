# =============================================================================
# api-gateway — required env vars
# =============================================================================
# Copy this file to .env and fill in the values. Anything commented out is
# deferred to a later phase per the handbook.

# ---- Server ----
API_GATEWAY_PORT=3333
NODE_ENV=development
LOG_LEVEL=info

# ---- Service URLs ----
# Local-dev defaults:
#   - crawler: 4000 (conventional Node.js dev port — Apollo, Phoenix)
#   - ai: 7860 (Hugging Face Spaces convention; matches the production
#               Dockerfile so local mirrors deploy)
CRAWLER_SERVICE_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:7860/api

# ---- Cache + Queue (Upstash Redis runs both per ADR 003) ----
# BullMQ + sse_token storage live here. Local dev: redis://localhost:6379
REDIS_URL="rediss://default:password@host:6379"

# ---- Database (Supabase / Postgres) ----
# Transaction Pooler (Port 6543) — runtime use
DATABASE_URL="postgresql://postgres.user:password@host:6543/postgres"
# Direct Connection (Port 5432) — required for `drizzle-kit generate/push`
DIRECT_URL="postgresql://postgres.user:password@host:5432/postgres?sslmode=require"

# ---- DIY JWT (jsonwebtoken) — REQUIRED ----
# Must be at least 32 chars. Generate via: openssl rand -hex 32
JWT_SECRET=

# ---- Public client URL — REQUIRED ----
# Single source of truth: used as the CORS allowed origin AND as the link base
# in audit-complete / welcome email templates. Must be the exact deployed
# client URL (no trailing slash). Production: your Vercel domain.
# Dev: http://localhost:5000
APP_URL=http://localhost:5000

# ---- Rate limiting ----
# Audit quota per identifier (anon = IP, free = userId). 0 means unlimited.
# Anon defaults to unlimited while we're in early-portfolio mode — flip to
# 1 (or higher) once we want a signup wall back. Free defaults to 3/month.
ANON_AUDIT_LIMIT=0
FREE_AUDIT_LIMIT=3

# ---- Body size limits ----
# Hard cap on request body bytes accepted by the gateway. JSON parser default
# would let a single misbehaving client OOM us; 1mb is plenty for our routes
# (the audit DTO is <1kb, even welcome-email payloads are tiny).
BODY_LIMIT=1mb

# ---- Email (per ADR 013) ----
# Resend is primary, SendGrid is fallback. EMAIL_FROM must be a verified
# sender in both providers (or you'll get bounces from one). At least one
# of the two API keys must be set; otherwise sends will fail at runtime.
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Rank Orbit <noreply@your-domain>"

# =============================================================================
# Deferred — wire up when the corresponding feature lands
# =============================================================================

# Phase 2 — refresh-token TTL (Phase 2 of ADR 002)
JWT_REFRESH_TTL=30d

# Phase 1 — internal-token HMAC for gateway → ai-service / crawler-service
INTERNAL_TOKEN_SECRET=

# Stripe (Phase 4 — paid tier)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
