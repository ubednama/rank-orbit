# ============================================
# Client (Next.js) Environment Configuration
# ============================================

# API Gateway URL (used by Next.js client for SSE and API calls)
# Note: This should point to your API Gateway
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3333/api

# Optional: Next.js Configuration
# NODE_ENV is typically managed by Next.js automatically
# NODE_ENV=development

# Optional: Analytics (if you're using Vercel Analytics or similar)
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here


# -----------------
# Auth0 Configuration
# -----------------
# Generate a secret matching your Next.js app's secret
# openssl rand -hex 32
AUTH0_SECRET='LONG_RANDOM_VALUE'
AUTH0_BASE_URL='http://localhost:5000'
AUTH0_ISSUER_BASE_URL='https://YOUR_AUTH0_DOMAIN'
AUTH0_CLIENT_ID='YOUR_CLIENT_ID'
AUTH0_CLIENT_SECRET='YOUR_CLIENT_SECRET'
