# =============================================================================
# crawler-service — required env vars
# =============================================================================

# ---- Server ----
# Default 4000 locally (conventional Node.js dev port). Production deploys
# bind via apps/crawler-service/fly.toml internal_port.
CRAWLER_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- Local Puppeteer ----
# Will be replaced by Browserless.io in a follow-up. For now we run
# headless Chromium locally.
PUPPETEER_HEADLESS=true
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# =============================================================================
# Deferred — wire up when the corresponding feature lands
# =============================================================================

# Browserless.io rewrite (per ADR 005)
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=wss://chrome.browserless.io

# Internal-token HMAC verification (only the gateway should call us)
# INTERNAL_TOKEN_SECRET=
