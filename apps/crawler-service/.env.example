# Server
CRAWLER_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Local Puppeteer (will be replaced by Browserless in phase 1 per ADR 005)
PUPPETEER_HEADLESS=true
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Phase 1 — Browserless.io rewrite per ADR 005
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=wss://chrome.browserless.io

# Phase 1 — internal-token HMAC verification (only gateway should call us)
# INTERNAL_TOKEN_SECRET=
